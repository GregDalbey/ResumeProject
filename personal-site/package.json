{
  "name": "personal-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/server.mjs",
    "dev:web": "vite",
    "generate:resume-pdf": "node scripts/generate-resume-pdf.mjs",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web",
    "build:docker": "npm run build:web",
    "start": "node server/server.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "md-to-pdf": "^5.2.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "eslint-visitor-keys": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.21"
  }
}
